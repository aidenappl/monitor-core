# HTTP Server
HTTP_PORT=8080

# ClickHouse Connection
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DATABASE=monitor
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# Authentication (leave empty to disable)
API_KEY=your-secret-key-here

# For docker-compose (maps to API_KEY in container)
MONITOR_API_KEY=your-secret-key-here

# Batching Configuration
BATCH_SIZE=1000
FLUSH_INTERVAL=5s
QUEUE_SIZE=100000

# Keyring (optional — if set, secrets above are fetched from Keyring at startup
# and override any values set directly in this file)
# KEYRING_URL=https://keys.cloud
# KEYRING_ACCESS_KEY_ID=KR...
# KEYRING_SECRET_ACCESS_KEY=...
